# Copy to .env and fill in. .env is gitignored; this file is not — keep real
# secrets out of it.
#
#   cp .env.example .env
#   docker compose up --build

# ── Public hostname & TLS ────────────────────────────────────────────────────
# The single hostname the whole platform is served from. Caddy obtains a Let's
# Encrypt certificate for it on first start and renews it automatically, so the
# name must ALREADY resolve to this server's public IP — ACME validates by
# connecting back over port 80. Set it and the web app, the API (/smbc) and
# profile photos (/photos) all come up on one origin over HTTPS.
#
# Plain http:// anywhere in this file is a Play Store rejection: the Android app
# sends phone numbers, OTP codes and auth tokens, and Google's User Data policy
# requires those to travel encrypted.
PUBLIC_DOMAIN=sammalani.example.com

# Where Let's Encrypt sends certificate-expiry warnings. Leave blank and it
# defaults to admin@$PUBLIC_DOMAIN; set a mailbox you actually read.
ACME_EMAIL=

# Signs every member and admin token. HMAC-SHA256 needs at least 256 bits, and
# the service refuses to start without it. Generate one:
#
#   openssl rand -base64 48
#
JWT_SECRET=

# Creates the first super admin, once, on a database that has none. Leave the
# password blank and the service still starts — it just warns that nobody can
# sign in yet. Clear it again after the account exists.
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD=

# Postgres password. The default is fine on a laptop and nowhere else.
DB_PASSWORD=alumni

# Origins allowed to call the API. In production the browser app is served from
# the same origin as the API, so this only needs to cover local development —
# leave it unset and it defaults to https://$PUBLIC_DOMAIN. The Android app is
# not a browser and is unaffected by CORS either way.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# API base URL baked into the web bundle at build time. Because Caddy serves the
# app and the API from one origin, this is a relative path — the bundle then
# works under any hostname and no domain is hardcoded into it. Only override it
# (with a full https:// URL) if you host the web app somewhere else.
VITE_API_BASE_URL=/smbc
VITE_CONTACT_PHONE=01943177909

# Published ports. Change these if 8080 or 8090 are already taken.
WEB_PORT=8080
API_PORT=8090

# ── Real-device testing (Android app on same Wi-Fi) ───────────────────────────
# web, api and minio bind to 127.0.0.1 so nothing can reach them except Caddy,
# which is the only service holding a public port. To open them on your LAN for
# device testing, override the bind address here (never on a public host — it
# puts the API back on the internet in cleartext, which is what got the app
# rejected in the first place):
#
#   WEB_BIND=0.0.0.0
#   API_BIND=0.0.0.0
#   MINIO_BIND=0.0.0.0
#
# Also update these so photo URLs and API calls resolve from the phone:
#   MINIO_PUBLIC_BASE_URL=http://192.168.1.x:9000
#   CORS_ORIGINS=http://192.168.1.x:8080,http://localhost:8080,http://localhost:5173
#
# And set dev.web_app_url in android/local.properties:
#   dev.web_app_url=http://192.168.1.x:8080

# Fixed OTP for demos, so you can log in without an SMS gateway. NEVER set this
# in production; the service logs a warning while it is present.
OTP_DEV_CODE=

LOG_LEVEL=INFO

# Set to false in production to disable Swagger UI and /v3/api-docs.
SWAGGER_ENABLED=true

# MinIO (S3-compatible object storage for profile photos).
# Defaults are fine on a laptop. Change in production and use a strong secret key.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_BUCKET=alumni-photos
# Public URL browsers and the Android app use to load photos. This is Caddy's
# /photos route, which strips the prefix and forwards to MinIO — never the MinIO
# port directly, which is loopback-only now. Leave unset in production and it
# defaults to https://$PUBLIC_DOMAIN/photos.
MINIO_PUBLIC_BASE_URL=http://localhost:9000
