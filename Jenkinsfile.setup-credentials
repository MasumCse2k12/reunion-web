// =============================================================================
//  Sammalani Alumni — one-time credentials setup pipeline
//
//  Run this pipeline ONCE to register all required secrets into Jenkins.
//  After it completes, Jenkinsfile.compose will find every credential it needs.
//
//  Requirements:
//    - Jenkins plugin: Credentials (installed by default)
//    - The user running this job must have "Credentials/Create" permission.
//    - In-process Script Approval may be required on first run:
//        Manage Jenkins → In-process Script Approval → Approve
//
//  How to create this job:
//    New Item → name: alumni-setup-credentials → Pipeline → OK
//    [x] This project is parameterised   (parameters appear on first save;
//                                         click "Build with Parameters" after)
//    Pipeline → Definition: Pipeline script from SCM → Git
//      URL:         https://github.com/MasumCse2k12/reunion-web.git
//      Branch:      */main
//      Script Path: Jenkinsfile.setup-credentials
//    Save → Build with Parameters → fill in the form → Build.
//
//  SECURITY: parameter values are visible in the build log on first run.
//  Run this job on a private Jenkins instance and delete the build history
//  afterwards:  Build → Delete build → Yes.
// =============================================================================

pipeline {
    agent any

    parameters {
        // ── Required secrets ──────────────────────────────────────────────────
        password(
            name: 'JWT_SECRET',
            defaultValue: '',
            description: 'HS256 signing key — run: openssl rand -hex 32'
        )
        password(
            name: 'DB_PASSWORD',
            defaultValue: '',
            description: 'PostgreSQL password for the alumni database'
        )
        password(
            name: 'MINIO_ACCESS_KEY',
            defaultValue: 'minioadmin',
            description: 'MinIO / S3 access key (username)'
        )
        password(
            name: 'MINIO_SECRET_KEY',
            defaultValue: '',
            description: 'MinIO / S3 secret key (password)'
        )
        password(
            name: 'BOOTSTRAP_ADMIN_PASSWORD',
            defaultValue: '',
            description: 'Password for the first superadmin account'
        )
        // ── Non-secret but environment-specific ───────────────────────────────
        string(
            name: 'CORS_ORIGINS',
            defaultValue: 'https://alumni.sammalani.edu.bd',
            description: 'Comma-separated allowed CORS origins'
        )
        string(
            name: 'MINIO_PUBLIC_BASE_URL',
            defaultValue: 'https://alumni.sammalani.edu.bd/photos',
            description: 'Public base URL for MinIO-served photos'
        )
    }

    stages {

        stage('Validate inputs') {
            steps {
                script {
                    def required = [
                        JWT_SECRET               : params.JWT_SECRET,
                        DB_PASSWORD              : params.DB_PASSWORD,
                        MINIO_SECRET_KEY         : params.MINIO_SECRET_KEY,
                        BOOTSTRAP_ADMIN_PASSWORD : params.BOOTSTRAP_ADMIN_PASSWORD,
                    ]
                    required.each { name, value ->
                        if (!value?.trim()) {
                            error("Parameter '${name}' is required and must not be empty.")
                        }
                    }
                    echo "All required parameters provided."
                }
            }
        }

        stage('Register credentials') {
            steps {
                script {
                    // Map of Jenkins credential ID → parameter value
                    def secrets = [
                        'ALUMNI_JWT_SECRET'              : params.JWT_SECRET,
                        'ALUMNI_DB_PASSWORD'             : params.DB_PASSWORD,
                        'ALUMNI_MINIO_ACCESS_KEY'        : params.MINIO_ACCESS_KEY,
                        'ALUMNI_MINIO_SECRET_KEY'        : params.MINIO_SECRET_KEY,
                        'ALUMNI_BOOTSTRAP_ADMIN_PASSWORD': params.BOOTSTRAP_ADMIN_PASSWORD,
                        'ALUMNI_CORS_ORIGINS'            : params.CORS_ORIGINS,
                        'ALUMNI_MINIO_PUBLIC_BASE_URL'   : params.MINIO_PUBLIC_BASE_URL,
                    ]

                    def domain = com.cloudbees.plugins.credentials.domains.Domain.global()
                    def store  = Jenkins.get()
                                    .getExtensionList(
                                        'com.cloudbees.plugins.credentials.SystemCredentialsProvider'
                                    )[0]
                                    .getStore()

                    secrets.each { credId, secret ->
                        def existing = com.cloudbees.plugins.credentials.CredentialsProvider
                            .lookupCredentials(
                                com.cloudbees.plugins.credentials.common.StandardCredentials,
                                Jenkins.get(),
                                null,
                                []
                            ).find { it.id == credId }

                        def newCred = new org.jenkinsci.plugins.plaincredentials.impl.StringCredentialsImpl(
                            com.cloudbees.plugins.credentials.CredentialsScope.GLOBAL,
                            credId,
                            "Sammalani Alumni — ${credId}",
                            hudson.util.Secret.fromString(secret)
                        )

                        if (existing) {
                            store.updateCredentials(domain, existing, newCred)
                            echo "Updated : ${credId}"
                        } else {
                            store.addCredentials(domain, newCred)
                            echo "Created : ${credId}"
                        }
                    }

                    echo "All credentials registered successfully."
                }
            }
        }

        stage('Verify') {
            steps {
                script {
                    def ids = [
                        'ALUMNI_JWT_SECRET',
                        'ALUMNI_DB_PASSWORD',
                        'ALUMNI_MINIO_ACCESS_KEY',
                        'ALUMNI_MINIO_SECRET_KEY',
                        'ALUMNI_BOOTSTRAP_ADMIN_PASSWORD',
                        'ALUMNI_CORS_ORIGINS',
                        'ALUMNI_MINIO_PUBLIC_BASE_URL',
                    ]

                    def all = com.cloudbees.plugins.credentials.CredentialsProvider
                        .lookupCredentials(
                            com.cloudbees.plugins.credentials.common.StandardCredentials,
                            Jenkins.get(),
                            null,
                            []
                        ).collect { it.id }

                    def missing = ids.findAll { !all.contains(it) }
                    if (missing) {
                        error("These credentials were not found after registration: ${missing}")
                    }
                    echo "Verification passed — all ${ids.size()} credentials are present."
                }
            }
        }
    }

    post {
        success {
            echo """
=== Setup complete ===
You can now run Jenkinsfile.compose to deploy the full stack.
IMPORTANT: Delete this build's console log to remove parameter values from history:
  Build history → this build → Delete build
"""
        }
        failure {
            echo "Setup failed — check the stage log above."
        }
    }
}
