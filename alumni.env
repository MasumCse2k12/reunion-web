# ── Ports (change only if defaults are taken) ─────────────────────────────────
WEB_PORT=8092
API_PORT=8090
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Redis (defaults work when using docker compose — override for external Redis)
REDIS_HOST=redis
REDIS_PORT=6380
REDIS_PASSWORD=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Dev-only (leave blank in production) ──────────────────────────────────────
OTP_DEV_CODE=
