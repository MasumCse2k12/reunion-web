# Sammalani Alumni — production .env
# Fill in every blank value, then upload this file to Jenkins:
#   Manage Jenkins → Credentials → System → Global → Add credential
#   Kind: Secret file · ID: ALUMNI_ENV_FILE
#
# Generate JWT_SECRET with: openssl rand -hex 32

# ── Required ──────────────────────────────────────────────────────────────────
JWT_SECRET=72766e8b1ba67151e07fe82dc451277b2421440b96845582a565cdf60fd90994
DB_URL=jdbc:postgresql://103.165.162.229:5432/alumni
DB_USER=alumni
DB_PASSWORD=alumni

# ── Admin bootstrap ───────────────────────────────────────────────────────────
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD=Sammilani@2027
BOOTSTRAP_ADMIN_PHONE=01943177909

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://103.165.162.229

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_SECRET_KEY=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_BUCKET=alumni-photos
