<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Splash-screen theme applied to MainActivity -->
    <style name="Theme.AlumniApp" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_600</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_reunion_emblem</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_600</item>
        <item name="postSplashScreenTheme">@style/Theme.AlumniApp.Main</item>
    </style>

    <!-- Main app theme — used by all activities except MainActivity -->
    <style name="Theme.AlumniApp.Main" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_600</item>
        <item name="colorPrimaryVariant">@color/brand_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/brand_600</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="colorAccent">@color/brand_600</item>
        <!-- TextInputLayout -->
        <item name="colorControlActivated">@color/brand_600</item>
        <item name="colorControlHighlight">@color/brand_100</item>
    </style>

    <!-- Full-screen dark hero theme (Landing page header) -->
    <style name="Theme.AlumniApp.Dark" parent="Theme.AlumniApp.Main">
        <item name="android:statusBarColor">@color/brand_800</item>
        <item name="android:navigationBarColor">@color/brand_900</item>
    </style>

</resources>
