<?xml version="1.0" encoding="utf-8"?>
<!--
    RELEASE network security policy — HTTPS only, system CAs only.
    The debug override in src/debug/res/xml/ replaces this file for debug builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
