<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- No networkSecurityConfig is declared on purpose. With none present the
         platform default applies, which blocks cleartext outright on API 28+, and
         usesCleartextTraffic="false" covers API 23-27. Debug builds attach a
         permissive config via src/debug/AndroidManifest.xml instead. -->
    <!-- allowBackup is off, and there is nothing here worth turning it back on
         for. The only things this app stores on the device are the access and
         refresh tokens, the member's own profile JSON (SessionManager's
         "sammalani_session" prefs) and the temporary camera captures under
         getExternalFilesDir — credentials and personal data, all of it, and all
         of it re-fetched from the server on the next sign-in. Left on, Android
         copies the lot into the user's Google Drive backup, which is somewhere
         nobody consented to their reunion profile and a live refresh token
         going. The cost of switching a phone is one OTP. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.AlumniApp"
        android:usesCleartextTraffic="false"
        android:localeConfig="@xml/locale_config">

        <!-- Entry point — shows the Grand Reunion 2027 splash then navigates -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Public landing page -->
        <activity
            android:name=".ui.LandingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AlumniApp.Main"
            android:windowSoftInputMode="adjustResize" />

        <!-- Login: phone + OTP -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AlumniApp.Main"
            android:windowSoftInputMode="adjustPan" />

        <!-- Signup: 4-step flow -->
        <activity
            android:name=".ui.SignupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AlumniApp.Main"
            android:windowSoftInputMode="adjustPan" />

        <!-- Main app shell: bottom nav with Dashboard / Batches / Guests / Profile -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AlumniApp.Main"
            android:windowSoftInputMode="adjustResize" />

        <!-- Batch detail: members by tab (found / missing / in memoriam) -->
        <activity
            android:name=".ui.BatchDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AlumniApp.Main"
            android:windowSoftInputMode="adjustResize" />

        <!-- FileProvider for sharing camera-capture URIs on API 24+ -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>
